{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/prepare-web.mjs",
  "outputDirectory": "web-deploy",
  "redirects": [
    {
      "source": "/",
      "destination": "/preview/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/audio_catalog.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
